          ],
          "children": [
            {
              "type": "text",
              "id": "seweZ",
              "fill": "#A8481F",
              "textGrowth": "fixed-width-height",
              "width": 900,
              "height": 39,
              "content": ">Claude: add a cute, techy, first-person tagline to my website masthead. I'm a CTO, and this website promotes my consulting/fractional CTO work.",
              "fontFamily": "Inter",
              "fontSize": 12,
              "fontWeight": "600",
              "letterSpacing": 2
            },
            {
              "type": "text",
              "id": "XR7vy",
              "fill": "#1B1A17",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "I help teams turn messy problems into shipped products.",
              "lineHeight": 1.1,
              "fontFamily": "Schibsted Grotesk",
              "fontSize": 50,
              "fontWeight": "600",
              "letterSpacing": -1
            }
          ]
        },
        {
          "type": "frame",
          "id": "BuH4i",
